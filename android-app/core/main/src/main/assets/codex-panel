#!/usr/bin/env sh
set -eu

usage() {
  printf '%s\n' "用法: codex-panel status [files|browser]"
  printf '%s\n' "      codex-panel events|wait"
  printf '%s\n' "      codex-panel result [files|browser]"
  printf '%s\n' "      codex-panel present|collapse|toggle files|browser [REASON]"
  printf '%s\n' "      codex-panel done|cancel files|browser [REASON]"
  printf '%s\n' "      codex-panel clear files [REASON]"
  printf '%s\n' "      codex-panel close browser [REASON]"
  printf '%s\n' "      codex-panel select|remove files FILE_ID"
}

find_prefix() {
  if [ -n "${PREFIX:-}" ]; then
    printf '%s\n' "$PREFIX"
    return 0
  fi
  if [ -n "${PKG:-}" ]; then
    [ -d "/data/user/0/$PKG" ] && { printf '%s\n' "/data/user/0/$PKG"; return 0; }
    [ -d "/data/data/$PKG" ] && { printf '%s\n' "/data/data/$PKG"; return 0; }
  fi
  return 1
}

print_file_if_readable() {
  file="$1"
  if [ -r "$file" ]; then
    cat "$file"
    return 0
  fi
  return 1
}

safe_id() {
  printf '%s' "$1" | tr -cd 'A-Za-z0-9._-' | cut -c 1-120
}

write_request() {
  bridge_dir="$1"
  shift
  request_file="$bridge_dir/request"
  queue_dir="$bridge_dir/queue"
  mkdir -p "$queue_dir"
  request_id="$(date +%s 2>/dev/null || printf 0).$$"
  safe_request_id="$(safe_id "$request_id")"
  req_tmp="$queue_dir/$safe_request_id.req.tmp.$$"
  req_file="$queue_dir/$safe_request_id.req"
  {
    printf 'request_id=%s\n' "$request_id"
    printf 'stamp=%s\n' "$request_id"
    printf 'queued=1\n'
    while [ "$#" -gt 0 ]; do
      printf '%s=%s\n' "$1" "$2"
      shift 2
    done
  } > "$req_tmp"
  legacy_tmp="$request_file.tmp.$$"
  cp "$req_tmp" "$legacy_tmp"
  mv "$legacy_tmp" "$request_file"
  mv "$req_tmp" "$req_file"
  printf '%s\n' "$request_id"
}

wait_events() {
  panel_dir="$1/local/agent-panel"
  events_file="$panel_dir/events"
  wait_seconds="${CODEX_PANEL_WAIT_SECONDS:-120}"
  start_size=0
  [ ! -f "$events_file" ] || start_size="$(wc -c < "$events_file" 2>/dev/null || printf 0)"
  elapsed=0
  while [ "$elapsed" -lt "$wait_seconds" ]; do
    if [ -s "$events_file" ]; then
      size="$(wc -c < "$events_file" 2>/dev/null || printf 0)"
      if [ "$size" != "$start_size" ]; then
        tail -n 60 "$events_file"
        return 0
      fi
    fi
    sleep 1
    elapsed=$((elapsed + 1))
  done
  printf '等待 Agent 面板事件超时\n' >&2
  return 1
}

prefix="$(find_prefix)" || {
  printf '%s\n' "找不到 App 数据目录: 请在 Codex for TUI 终端内运行。" >&2
  exit 1
}

[ "$#" -ge 1 ] || { usage >&2; exit 2; }

cmd="$1"
shift

case "$cmd" in
  status)
    target="${1:-panel}"
    case "$target" in
      files|file|preview) print_file_if_readable "$prefix/local/media-preview/status" || true ;;
      browser) print_file_if_readable "$prefix/local/browser/status" || true ;;
      panel|agent) print_file_if_readable "$prefix/local/agent-panel/status" || true ;;
      *) usage >&2; exit 2 ;;
    esac
    exit 0
    ;;
  events)
    print_file_if_readable "$prefix/local/agent-panel/events" || true
    exit 0
    ;;
  wait)
    wait_events "$prefix"
    exit $?
    ;;
  result)
    target="${1:-panel}"
    case "$target" in
      files|file|preview) print_file_if_readable "$prefix/local/media-preview/result" || true ;;
      browser) print_file_if_readable "$prefix/local/browser/result.json" || true ;;
      panel|agent) print_file_if_readable "$prefix/local/agent-panel/result" || true ;;
      *) usage >&2; exit 2 ;;
    esac
    exit 0
    ;;
esac

[ "$#" -ge 1 ] || { usage >&2; exit 2; }
target="$1"
shift

case "$target" in
  files|file|preview)
    bridge_dir="$prefix/local/media-preview"
    case "$cmd" in
      present|show)
        reason="${*:-agent_present}"
        request_id="$(write_request "$bridge_dir" action present present 1 reason "$reason")"
        ;;
      collapse|hide)
        reason="${*:-agent_collapse}"
        request_id="$(write_request "$bridge_dir" action collapse present 0 reason "$reason")"
        ;;
      toggle)
        reason="${*:-agent_toggle}"
        request_id="$(write_request "$bridge_dir" action toggle reason "$reason")"
        ;;
      clear|close)
        reason="${*:-agent_clear}"
        request_id="$(write_request "$bridge_dir" action clear reason "$reason")"
        ;;
      done)
        reason="${*:-agent_done}"
        request_id="$(write_request "$bridge_dir" action done reason "$reason")"
        ;;
      cancel)
        reason="${*:-agent_cancel}"
        request_id="$(write_request "$bridge_dir" action cancel reason "$reason")"
        ;;
      select|remove|delete)
        [ "$#" -eq 1 ] || { usage >&2; exit 2; }
        action="$cmd"
        [ "$cmd" = "delete" ] && action="remove"
        request_id="$(write_request "$bridge_dir" action "$action" item_id "$1" reason "$cmd")"
        ;;
      *)
        usage >&2
        exit 2
        ;;
    esac
    ;;
  browser)
    bridge_dir="$prefix/local/browser"
    case "$cmd" in
      present|show)
        reason="${*:-agent_present}"
        request_id="$(write_request "$bridge_dir" action present present 1 reason "$reason")"
        ;;
      collapse|hide)
        reason="${*:-agent_collapse}"
        request_id="$(write_request "$bridge_dir" action collapse present 0 reason "$reason")"
        ;;
      toggle)
        reason="${*:-agent_toggle}"
        request_id="$(write_request "$bridge_dir" action toggle reason "$reason")"
        ;;
      done)
        reason="${*:-agent_done}"
        request_id="$(write_request "$bridge_dir" action user_done reason "$reason")"
        ;;
      cancel)
        reason="${*:-agent_cancel}"
        request_id="$(write_request "$bridge_dir" action user_cancelled reason "$reason")"
        ;;
      close)
        reason="${*:-agent_close}"
        request_id="$(write_request "$bridge_dir" action close reason "$reason")"
        ;;
      *)
        usage >&2
        exit 2
        ;;
    esac
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac

printf '已发送到 Codex for TUI Agent 面板: %s\n' "$request_id"
