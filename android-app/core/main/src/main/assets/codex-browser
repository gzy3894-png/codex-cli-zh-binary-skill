#!/usr/bin/env sh
set -eu

usage() {
  printf '%s\n' "用法: codex-browser [--no-wait] open [--present] URL"
  printf '%s\n' "      codex-browser present|collapse|toggle [REASON]"
  printf '%s\n' "      codex-browser new-tab [URL] | list-tabs | select-tab ID | close-tab [ID]"
  printf '%s\n' "      codex-browser back|forward|reload|history|clear-history"
  printf '%s\n' "      codex-browser click CSS_SELECTOR | type CSS_SELECTOR TEXT | scroll [up|down] [amount]"
  printf '%s\n' "      codex-browser get-text [CSS_SELECTOR] | get-readable | js SCRIPT"
  printf '%s\n' "      codex-browser screenshot [--push] [--background]"
  printf '%s\n' "      codex-browser cookies status|verify URL | cookies flush"
  printf '%s\n' "      codex-browser userscript add NAME MATCH FILE"
  printf '%s\n' "      codex-browser userscript list|enable|disable|remove ID"
  printf '%s\n' "      codex-browser user-wait|wait-user [MESSAGE]"
  printf '%s\n' "      codex-browser auth-open [--open-now] [--reason TEXT] [--code CODE] URL"
  printf '%s\n' "      codex-browser auth-wait|auth-status|auth-done|auth-cancel|auth-reopen REQUEST_ID"
  printf '%s\n' "      codex-browser external-confirm|external-cancel REQUEST_ID"
  printf '%s\n' "      codex-browser auth|external URL"
  printf '%s\n' "      codex-browser status|events|wait|result [REQUEST_ID]|close"
}

find_prefix() {
  if [ -n "${PREFIX:-}" ]; then
    printf '%s\n' "$PREFIX"
    return 0
  fi
  if [ -n "${PKG:-}" ]; then
    [ -d "/data/user/0/$PKG" ] && { printf '%s\n' "/data/user/0/$PKG"; return 0; }
    [ -d "/data/data/$PKG" ] && { printf '%s\n' "/data/data/$PKG"; return 0; }
  fi
  return 1
}

safe_id() {
  printf '%s' "$1" | tr -cd 'A-Za-z0-9._-' | cut -c 1-120
}

write_request() {
  bridge_dir="$1/local/browser"
  shift
  request_file="$bridge_dir/request"
  queue_dir="$bridge_dir/queue"
  mkdir -p "$queue_dir"
  request_id="$(date +%s 2>/dev/null || printf 0).$$"
  safe_request_id="$(safe_id "$request_id")"
  req_tmp="$bridge_dir/.$safe_request_id.req.tmp.$$"
  queue_tmp="$queue_dir/.$safe_request_id.req.tmp.$$"
  req_file="$queue_dir/$safe_request_id.req"
  {
    printf 'request_id=%s\n' "$request_id"
    printf 'stamp=%s\n' "$request_id"
    printf 'queued=1\n'
    while [ "$#" -gt 0 ]; do
      printf '%s=%s\n' "$1" "$2"
      shift 2
    done
  } > "$req_tmp"
  cp "$req_tmp" "$queue_tmp"
  mv "$queue_tmp" "$req_file"

  # Legacy fallback for older app builds. Newer builds de-duplicate by request_id.
  legacy_tmp="$request_file.tmp.$$"
  cp "$req_tmp" "$legacy_tmp"
  mv "$legacy_tmp" "$request_file"
  rm -f "$req_tmp"
  printf '%s\n' "$request_id"
}

print_file_if_readable() {
  file="$1"
  if [ -r "$file" ]; then
    cat "$file"
    return 0
  fi
  return 1
}

print_events_for_target() {
  target="$1"
  events_file="$2"
  [ -r "$events_file" ] || return 1
  case "$target" in
    panel|agent|all|"")
      cat "$events_file"
      return 0
      ;;
    files|file|preview)
      wanted="files"
      ;;
    browser)
      wanted="browser"
      ;;
    *)
      return 2
      ;;
  esac
  awk -v wanted="$wanted" '
    function record_matches(record) {
      if (wanted == "files") {
        return record ~ /(^|\n)source=files(\n|$)/ || record ~ /(^|\n)mode=files(\n|$)/ || record ~ /(^|\n)source=media-preview(\n|$)/
      }
      if (wanted == "browser") {
        return record ~ /(^|\n)source=browser(\n|$)/ || record ~ /(^|\n)mode=browser(\n|$)/
      }
      return 1
    }
    function emit() {
      if (buf == "") return
      if (record_matches(buf)) {
        printf "%s", buf
        print "---"
      }
      buf = ""
    }
    /^---$/ { emit(); next }
    { buf = buf $0 "\n" }
    END { emit() }
  ' "$events_file"
}

wait_status() {
  bridge_dir="$1/local/browser"
  request_id="$2"
  status_file="$bridge_dir/status"
  safe_request_id="$(safe_id "$request_id")"
  request_status_file="$bridge_dir/results/$safe_request_id.status"
  wait_seconds="${CODEX_BROWSER_WAIT_SECONDS:-25}"
  elapsed=0
  while [ "$elapsed" -lt "$wait_seconds" ]; do
    if [ -s "$request_status_file" ]; then
      state="$(sed -n 's/^state=//p' "$request_status_file" | sed -n '1p')"
      case "$state" in
        done|closed|ready|cancelled|waiting_for_user|collapsed|reopened|user_done)
          cat "$request_status_file"
          return 0
          ;;
        error)
          cat "$request_status_file" >&2
          return 1
          ;;
      esac
    elif [ -s "$status_file" ] && grep -F "request_id=$request_id" "$status_file" >/dev/null 2>&1; then
      state="$(sed -n 's/^state=//p' "$status_file" | sed -n '1p')"
      case "$state" in
          done|closed|ready|cancelled|collapsed|reopened|user_done)
          cat "$status_file"
          return 0
          ;;
        waiting_for_user)
          if [ "${CODEX_BROWSER_WAIT_USER_DONE:-0}" = "1" ]; then
            :
          else
            cat "$status_file"
            return 0
          fi
          ;;
        error)
          cat "$status_file" >&2
          return 1
          ;;
      esac
    fi
    sleep 1
    elapsed=$((elapsed + 1))
  done
  printf '等待浏览器动作超时: request_id=%s\n' "$request_id" >&2
  return 1
}

wait_events() {
  panel_dir="$1/local/agent-panel"
  events_file="$panel_dir/events"
  wait_seconds="${CODEX_BROWSER_EVENT_WAIT_SECONDS:-120}"
  start_size=0
  [ ! -f "$events_file" ] || start_size="$(wc -c < "$events_file" 2>/dev/null || printf 0)"
  elapsed=0
  while [ "$elapsed" -lt "$wait_seconds" ]; do
    if [ -s "$events_file" ]; then
      size="$(wc -c < "$events_file" 2>/dev/null || printf 0)"
      if [ "$size" != "$start_size" ]; then
        tail -n 40 "$events_file"
        return 0
      fi
    fi
    sleep 1
    elapsed=$((elapsed + 1))
  done
  printf '等待浏览器事件超时\n' >&2
  return 1
}

wait_auth_status() {
  bridge_dir="$1/local/browser"
  request_id="$2"
  safe_request_id="$(safe_id "$request_id")"
  request_status_file="$bridge_dir/results/$safe_request_id.status"
  wait_seconds="${CODEX_BROWSER_AUTH_WAIT_SECONDS:-${CODEX_BROWSER_WAIT_SECONDS:-300}}"
  elapsed=0
  while [ "$elapsed" -lt "$wait_seconds" ]; do
    if [ -s "$request_status_file" ]; then
      state="$(sed -n 's/^state=//p' "$request_status_file" | sed -n '1p')"
      case "$state" in
        user_done|cancelled|collapsed|reopened|error)
          cat "$request_status_file"
          [ "$state" != "error" ]
          return $?
          ;;
      esac
    fi
    sleep 1
    elapsed=$((elapsed + 1))
  done
  printf '等待 Auth 用户动作超时: request_id=%s\n' "$request_id" >&2
  return 1
}

copy_userscript() {
  prefix="$1"
  id="$2"
  source="$3"
  [ -r "$source" ] || {
    printf 'userscript 文件不可读: %s\n' "$source" >&2
    exit 1
  }
  dir="$prefix/local/browser/userscripts/incoming"
  mkdir -p "$dir"
  target="$dir/$(safe_id "$id").js"
  cp "$source" "$target"
  printf '%s\n' "$target"
}

wait=1
if [ "${1:-}" = "--no-wait" ]; then
  wait=0
  shift
fi

[ "$#" -ge 1 ] || { usage >&2; exit 2; }

prefix="$(find_prefix)" || {
  printf '%s\n' "找不到 App 数据目录: 请在 Codex for TUI 终端内运行。" >&2
  exit 1
}

cmd="$1"
shift
post_hint=0

case "$cmd" in
  open|navigate)
    present=0
    if [ "${1:-}" = "--present" ]; then
      present=1
      shift
    fi
    [ "$#" -ge 1 ] || { usage >&2; exit 2; }
    url="$1"
    shift
    if [ "$#" -gt 0 ]; then
      if [ "$#" -eq 1 ] && [ "$1" = "status" ]; then
        post_hint=1
      elif [ "$#" -eq 2 ] && [ "$1" = "codex-browser" ] && [ "$2" = "status" ]; then
        post_hint=1
      else
        usage >&2
        exit 2
      fi
    fi
    request_id="$(write_request "$prefix" action navigate present "$present" url "$url")"
    ;;
  present|show)
    reason="${*:-present}"
    request_id="$(write_request "$prefix" action present present 1 reason "$reason")"
    ;;
  collapse|hide)
    reason="${*:-collapse}"
    request_id="$(write_request "$prefix" action collapse present 0 reason "$reason")"
    ;;
  toggle)
    reason="${*:-toggle}"
    request_id="$(write_request "$prefix" action toggle reason "$reason")"
    ;;
  auth|external|custom-tab)
    [ "$#" -eq 1 ] || { usage >&2; exit 2; }
    action="$cmd"
    [ "$cmd" = "custom-tab" ] && action="custom_tab"
    request_id="$(write_request "$prefix" action "$action" url "$1")"
    ;;
  auth-open|auth_open)
    reason="安全登录/验证"
    code=""
    open_now=0
    url=""
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --open-now|--auto-open)
          open_now=1
          ;;
        --reason)
          shift
          [ "$#" -gt 0 ] || { usage >&2; exit 2; }
          reason="$1"
          ;;
        --code)
          shift
          [ "$#" -gt 0 ] || { usage >&2; exit 2; }
          code="$1"
          ;;
        --)
          shift
          [ "$#" -gt 0 ] || { usage >&2; exit 2; }
          url="$1"
          ;;
        --*)
          usage >&2
          exit 2
          ;;
        *)
          url="$1"
          ;;
      esac
      shift
    done
    [ -n "$url" ] || { usage >&2; exit 2; }
    request_id="$(write_request "$prefix" action auth_open present 1 open_now "$open_now" reason "$reason" code "$code" url "$url")"
    ;;
  auth-wait|auth_wait)
    [ "$#" -eq 1 ] || { usage >&2; exit 2; }
    wait_auth_status "$prefix" "$1"
    exit $?
    ;;
  auth-status|auth_status)
    [ "$#" -eq 1 ] || { usage >&2; exit 2; }
    safe_request_id="$(safe_id "$1")"
    print_file_if_readable "$prefix/local/browser/results/$safe_request_id.status" || true
    exit 0
    ;;
  auth-done|auth_done)
    [ "$#" -eq 1 ] || { usage >&2; exit 2; }
    target_request_id="$1"
    write_request "$prefix" action auth_done auth_request_id "$target_request_id" >/dev/null
    request_id="$target_request_id"
    ;;
  auth-cancel|auth_cancel)
    [ "$#" -eq 1 ] || { usage >&2; exit 2; }
    target_request_id="$1"
    write_request "$prefix" action auth_cancel auth_request_id "$target_request_id" >/dev/null
    request_id="$target_request_id"
    ;;
  auth-reopen|auth_reopen)
    [ "$#" -eq 1 ] || { usage >&2; exit 2; }
    target_request_id="$1"
    write_request "$prefix" action auth_reopen auth_request_id "$target_request_id" >/dev/null
    request_id="$target_request_id"
    ;;
  external-confirm|external_confirm)
    [ "$#" -eq 1 ] || { usage >&2; exit 2; }
    target_request_id="$1"
    write_request "$prefix" action external_confirm external_request_id "$target_request_id" >/dev/null
    request_id="$target_request_id"
    ;;
  external-cancel|external_cancel)
    [ "$#" -eq 1 ] || { usage >&2; exit 2; }
    target_request_id="$1"
    write_request "$prefix" action external_cancel external_request_id "$target_request_id" >/dev/null
    request_id="$target_request_id"
    ;;
  reload|snapshot|user-done|done|cancel|close)
    action="$cmd"
    [ "$cmd" = "user-done" ] && action="user_done"
    [ "$cmd" = "done" ] && action="user_done"
    [ "$cmd" = "cancel" ] && action="user_cancelled"
    request_id="$(write_request "$prefix" action "$action")"
    ;;
  screenshot)
    push=0
    present_files=1
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --push) push=1 ;;
        --background|--no-present) present_files=0 ;;
        *) usage >&2; exit 2 ;;
      esac
      shift
    done
    request_id="$(write_request "$prefix" action screenshot push "$push" present_files "$present_files")"
    ;;
  status)
    print_file_if_readable "$prefix/local/browser/status" || true
    exit 0
    ;;
  events)
    print_events_for_target browser "$prefix/local/agent-panel/events" || true
    exit 0
    ;;
  result)
    if [ "$#" -gt 0 ]; then
      safe_request_id="$(safe_id "$1")"
      print_file_if_readable "$prefix/local/browser/results/$safe_request_id.json" || true
    else
      print_file_if_readable "$prefix/local/browser/result.json" || true
    fi
    exit 0
    ;;
  wait)
    wait_events "$prefix"
    exit $?
    ;;
  back)
    request_id="$(write_request "$prefix" action back)"
    ;;
  forward)
    request_id="$(write_request "$prefix" action forward)"
    ;;
  new-tab|new_tab)
    if [ "$#" -gt 0 ]; then
      request_id="$(write_request "$prefix" action new_tab url "$1")"
    else
      request_id="$(write_request "$prefix" action new_tab)"
    fi
    ;;
  list-tabs|tabs)
    request_id="$(write_request "$prefix" action list_tabs)"
    ;;
  select-tab|select_tab)
    [ "$#" -eq 1 ] || { usage >&2; exit 2; }
    request_id="$(write_request "$prefix" action select_tab tab_id "$1")"
    ;;
  close-tab|close_tab)
    if [ "$#" -gt 0 ]; then
      request_id="$(write_request "$prefix" action close_tab tab_id "$1")"
    else
      request_id="$(write_request "$prefix" action close_tab)"
    fi
    ;;
  history)
    request_id="$(write_request "$prefix" action history)"
    ;;
  clear-history|clear_history)
    request_id="$(write_request "$prefix" action clear_history)"
    ;;
  cookies)
    [ "$#" -ge 1 ] || { usage >&2; exit 2; }
    subcmd="$1"
    shift
    case "$subcmd" in
      status)
        [ "$#" -eq 1 ] || { usage >&2; exit 2; }
        request_id="$(write_request "$prefix" action cookies_status url "$1")"
        ;;
      verify)
        [ "$#" -eq 1 ] || { usage >&2; exit 2; }
        request_id="$(write_request "$prefix" action cookies_verify url "$1")"
        ;;
      flush)
        [ "$#" -eq 0 ] || { usage >&2; exit 2; }
        request_id="$(write_request "$prefix" action cookies_flush)"
        ;;
      *) usage >&2; exit 2 ;;
    esac
    ;;
  userscript)
    [ "$#" -ge 1 ] || { usage >&2; exit 2; }
    subcmd="$1"
    shift
    case "$subcmd" in
      add)
        [ "$#" -eq 3 ] || { usage >&2; exit 2; }
        name="$1"
        match="$2"
        source="$3"
        script_id="$(date +%s 2>/dev/null || printf 0).$$"
        copied_path="$(copy_userscript "$prefix" "$script_id" "$source")"
        request_id="$(write_request "$prefix" action userscript_add id "$script_id" name "$name" match "$match" path "$copied_path")"
        ;;
      list)
        [ "$#" -eq 0 ] || { usage >&2; exit 2; }
        request_id="$(write_request "$prefix" action userscript_list)"
        ;;
      enable)
        [ "$#" -eq 1 ] || { usage >&2; exit 2; }
        request_id="$(write_request "$prefix" action userscript_enable id "$1")"
        ;;
      disable)
        [ "$#" -eq 1 ] || { usage >&2; exit 2; }
        request_id="$(write_request "$prefix" action userscript_disable id "$1")"
        ;;
      remove)
        [ "$#" -eq 1 ] || { usage >&2; exit 2; }
        request_id="$(write_request "$prefix" action userscript_remove id "$1")"
        ;;
      *) usage >&2; exit 2 ;;
    esac
    ;;
  click)
    [ "$#" -eq 1 ] || { usage >&2; exit 2; }
    request_id="$(write_request "$prefix" action click selector "$1")"
    ;;
  type)
    [ "$#" -ge 2 ] || { usage >&2; exit 2; }
    selector="$1"
    shift
    request_id="$(write_request "$prefix" action type selector "$selector" text "$*")"
    ;;
  scroll)
    direction="${1:-down}"
    amount="${2:-600}"
    request_id="$(write_request "$prefix" action scroll direction "$direction" amount "$amount")"
    ;;
  get-text)
    if [ "$#" -gt 0 ]; then
      request_id="$(write_request "$prefix" action get_text selector "$1")"
    else
      request_id="$(write_request "$prefix" action get_text)"
    fi
    ;;
  get-readable)
    request_id="$(write_request "$prefix" action get_readable)"
    ;;
  js|execute-js)
    [ "$#" -ge 1 ] || { usage >&2; exit 2; }
    request_id="$(write_request "$prefix" action execute_js script "$*")"
    ;;
  user-wait|wait-user)
    message="${*:-请在浏览器中手动处理后继续}"
    request_id="$(write_request "$prefix" action user_wait present 1 message "$message")"
    CODEX_BROWSER_WAIT_USER_DONE=1
    CODEX_BROWSER_WAIT_SECONDS="${CODEX_BROWSER_WAIT_SECONDS:-300}"
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac

printf '已发送到 Codex for TUI 浏览器: %s\n' "$request_id"
if [ "$post_hint" -eq 1 ]; then
  printf '%s\n' "提示：status 要另起一行执行：codex-browser status"
fi
[ "$wait" -eq 0 ] || wait_status "$prefix" "$request_id"
