#!/usr/bin/env sh
set -eu

MARK_BEGIN="# codex-for-tui-context-hook begin"
MARK_END="# codex-for-tui-context-hook end"

usage() {
  printf '%s\n' "用法: codex-context status|events|hook|enable|disable|verify"
  printf '%s\n' "status 会汇报 token_count、context_compacted 记录和本机推断的压缩路线。"
}

codex_home() {
  printf '%s\n' "${CODEX_HOME:-$HOME/.codex}"
}

config_file() {
  printf '%s/config.toml\n' "$(codex_home)"
}

requirements_file() {
  printf '%s\n' "${CODEX_FOR_TUI_REQUIREMENTS_FILE:-/etc/codex/requirements.toml}"
}

state_dir() {
  printf '%s/context-state\n' "$(codex_home)"
}

backup_file() {
  file="$1"
  [ -e "$file" ] || return 0
  stamp="$(date +%Y%m%d%H%M%S 2>/dev/null || printf 0)"
  cp -p "$file" "$file.codex-context.bak.$stamp"
}

strip_managed_block() {
  input="$1"
  output="$2"
  awk -v begin="$MARK_BEGIN" -v end="$MARK_END" '
    $0 == begin { skip = 1; next }
    $0 == end { skip = 0; next }
    !skip { print }
  ' "$input" > "$output"
}

set_hooks_feature() {
  value="$1"
  cfg="$(config_file)"
  home_dir="$(codex_home)"
  mkdir -p "$home_dir"
  [ -f "$cfg" ] || : > "$cfg"
  backup_file "$cfg"
  tmp="$cfg.tmp.$$"
  awk -v desired="$value" '
    function is_section(line) { return line ~ /^[[:space:]]*\[[^]]+\][[:space:]]*$/ }
    function section_name(line, value) {
      value = line
      sub(/^[[:space:]]*\[/, "", value)
      sub(/\][[:space:]]*$/, "", value)
      return value
    }
    function flush_features() {
      if (section == "features" && hooks_seen == 0) {
        print "hooks = " desired
        hooks_seen = 1
      }
    }
    BEGIN {
      section = ""
      features_seen = 0
      hooks_seen = 0
    }
    {
      if (is_section($0)) {
        flush_features()
        section = section_name($0)
        if (section == "features") {
          features_seen = 1
          hooks_seen = 0
        }
        print
        next
      }
      if (section == "features" && $0 ~ /^[[:space:]]*hooks[[:space:]]*=/) {
        print "hooks = " desired
        hooks_seen = 1
        next
      }
      print
    }
    END {
      flush_features()
      if (features_seen == 0) {
        print ""
        print "[features]"
        print "hooks = " desired
      }
    }
  ' "$cfg" > "$tmp"
  mv "$tmp" "$cfg"
  chmod 600 "$cfg" 2>/dev/null || true
}

hook_configured() {
  cfg="$(config_file)"
  [ -f "$cfg" ] && grep -F "$MARK_BEGIN" "$cfg" >/dev/null 2>&1
}

requirements_hook_configured() {
  req="$(requirements_file)"
  [ -r "$req" ] || return 1
  awk -v begin="# codex-for-tui-managed-hooks begin" \
    -v end="# codex-for-tui-managed-hooks end" \
    -v cmd='command = "codex-context hook"' '
    $0 == begin { in_block = 1; next }
    $0 == end { in_block = 0; next }
    in_block && index($0, cmd) { found = 1 }
    END { if (found) exit 0; exit 1 }
  ' "$req"
}

hook_source() {
  cfg_has=0
  req_has=0
  hook_configured && cfg_has=1
  requirements_hook_configured && req_has=1
  if [ "$cfg_has" -eq 1 ] && [ "$req_has" -eq 1 ]; then
    printf '%s\n' "both"
  elif [ "$req_has" -eq 1 ]; then
    printf '%s\n' "requirements"
  elif [ "$cfg_has" -eq 1 ]; then
    printf '%s\n' "config"
  else
    printf '%s\n' "disabled"
  fi
}

install_hook_block() {
  cfg="$(config_file)"
  home_dir="$(codex_home)"
  mkdir -p "$home_dir"
  [ -f "$cfg" ] || : > "$cfg"
  backup_file "$cfg"
  tmp="$cfg.tmp.$$"
  strip_managed_block "$cfg" "$tmp"
  {
    cat "$tmp"
    printf '\n%s\n' "$MARK_BEGIN"
    printf '[[hooks.PreCompact]]\n'
    printf 'matcher = "manual|auto"\n\n'
    printf '[[hooks.PreCompact.hooks]]\n'
    printf 'type = "command"\n'
    printf 'command = "codex-context hook"\n'
    printf 'timeout = 5\n'
    printf 'statusMessage = "Recording context compact start"\n\n'
    printf '[[hooks.PostCompact]]\n'
    printf 'matcher = "manual|auto"\n\n'
    printf '[[hooks.PostCompact.hooks]]\n'
    printf 'type = "command"\n'
    printf 'command = "codex-context hook"\n'
    printf 'timeout = 5\n'
    printf 'statusMessage = "Recording context compact finish"\n\n'
    printf '[[hooks.SessionStart]]\n'
    printf 'matcher = "startup|resume|compact"\n\n'
    printf '[[hooks.SessionStart.hooks]]\n'
    printf 'type = "command"\n'
    printf 'command = "codex-context hook"\n'
    printf 'timeout = 5\n'
    printf 'statusMessage = "Recording Codex session start"\n'
    printf '%s\n' "$MARK_END"
  } > "$cfg"
  rm -f "$tmp"
  chmod 600 "$cfg" 2>/dev/null || true
}

remove_hook_block() {
  cfg="$(config_file)"
  [ -f "$cfg" ] || return 0
  backup_file "$cfg"
  tmp="$cfg.tmp.$$"
  strip_managed_block "$cfg" "$tmp"
  mv "$tmp" "$cfg"
  chmod 600 "$cfg" 2>/dev/null || true
}

json_value() {
  key="$1"
  sed -n 's/.*"'"$key"'"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | sed -n '1p'
}

json_string_field() {
  key="$1"
  sed -n 's/.*"'"$key"'"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | sed -n '1p'
}

json_number_field() {
  key="$1"
  sed -n 's/.*"'"$key"'"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\).*/\1/p' | sed -n '1p'
}

json_object_number_field() {
  object="$1"
  key="$2"
  sed -n 's/.*"'"$object"'"[[:space:]]*:[[:space:]]*{[^}]*"'"$key"'"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\).*/\1/p' | sed -n '1p'
}

toml_clean_value() {
  sed 's/[[:space:]]*#.*$//' | sed 's/^[[:space:]]*//' | sed 's/[[:space:]]*$//' | sed 's/^"//; s/"$//'
}

toml_top_value() {
  key="$1"
  cfg="$(config_file)"
  [ -r "$cfg" ] || return 0
  awk -v key="$key" '
    function section_name(line, value) {
      value = line
      sub(/^[[:space:]]*\[/, "", value)
      sub(/\][[:space:]]*$/, "", value)
      return value
    }
    BEGIN { section = "" }
    /^[[:space:]]*\[[^]]+\][[:space:]]*$/ {
      section = section_name($0)
      next
    }
    section == "" {
      line = $0
      sub(/[[:space:]]*#.*$/, "", line)
      if (line ~ "^[[:space:]]*" key "[[:space:]]*=") {
        sub(/^[^=]*=/, "", line)
        print line
        exit
      }
    }
  ' "$cfg" | toml_clean_value | sed -n '1p'
}

toml_section_value() {
  target="$1"
  key="$2"
  cfg="$(config_file)"
  [ -r "$cfg" ] || return 0
  awk -v target="$target" -v key="$key" '
    function section_name(line, value) {
      value = line
      sub(/^[[:space:]]*\[/, "", value)
      sub(/\][[:space:]]*$/, "", value)
      return value
    }
    BEGIN { section = "" }
    /^[[:space:]]*\[[^]]+\][[:space:]]*$/ {
      section = section_name($0)
      next
    }
    section == target {
      line = $0
      sub(/[[:space:]]*#.*$/, "", line)
      if (line ~ "^[[:space:]]*" key "[[:space:]]*=") {
        sub(/^[^=]*=/, "", line)
        print line
        exit
      }
    }
  ' "$cfg" | toml_clean_value | sed -n '1p'
}

url_host() {
  value="$1"
  [ -n "$value" ] || return 0
  value="${value#*://}"
  value="${value%%/*}"
  value="${value%%:*}"
  printf '%s\n' "$value"
}

config_route_status() {
  provider_id="$(toml_top_value model_provider)"
  [ -n "$provider_id" ] || provider_id="default"
  provider_section="model_providers.$provider_id"
  provider_name="$(toml_section_value "$provider_section" name)"
  base_url="$(toml_section_value "$provider_section" base_url)"
  base_url_host="$(url_host "$base_url")"
  wire_api="$(toml_section_value "$provider_section" wire_api)"
  remote_v2="$(toml_section_value features remote_compaction_v2)"
  [ -n "$remote_v2" ] || remote_v2="default"
  [ -n "$provider_name" ] || provider_name="unknown"
  [ -n "$base_url_host" ] || base_url_host="unknown"
  [ -n "$wire_api" ] || wire_api="unknown"

  supports_remote="false"
  case "$provider_name" in
    OpenAI|AzureOpenAI|Azure\ OpenAI)
      supports_remote="true"
      ;;
  esac
  case "$base_url_host" in
    api.openai.com|*.openai.azure.com)
      supports_remote="true"
      ;;
  esac

  if [ "$supports_remote" = "true" ]; then
    case "$remote_v2" in
      true) route="remote_v2" ;;
      *) route="remote" ;;
    esac
  else
    route="local"
  fi

  printf 'model_provider=%s\n' "$provider_id"
  printf 'provider_name=%s\n' "$provider_name"
  printf 'provider_base_url_host=%s\n' "$base_url_host"
  printf 'provider_wire_api=%s\n' "$wire_api"
  printf 'remote_compaction_v2_enabled=%s\n' "$remote_v2"
  printf 'supports_remote_compaction=%s\n' "$supports_remote"
  printf 'compaction_route_inferred=%s\n' "$route"
  printf 'compaction_route_basis=%s\n' "config+codex-source-rules"
}

scan_transcript_status() {
  sessions_root="$(codex_home)/sessions"
  printf 'sessions_root=%s\n' "$sessions_root"
  if [ ! -d "$sessions_root" ]; then
    printf 'token_count_status=missing\n'
    printf 'compactions_seen=0\n'
    printf 'latest_compaction_timestamp=none\n'
    return 0
  fi

  files="$(find "$sessions_root" -type f -name '*.jsonl' 2>/dev/null | sort | tail -n 40 || true)"
  if [ -z "$files" ]; then
    printf 'token_count_status=missing\n'
    printf 'compactions_seen=0\n'
    printf 'latest_compaction_timestamp=none\n'
    return 0
  fi

  latest_token_line=""
  latest_token_file=""
  latest_compaction_timestamp=""
  latest_compaction_file=""
  latest_compaction_kind=""
  compaction_count=0

  for file in $files; do
    [ -r "$file" ] || continue
    while IFS= read -r line; do
      case "$line" in
        *'"token_count"'*)
          latest_token_line="$line"
          latest_token_file="$file"
          ;;
      esac
      case "$line" in
        *'"context_compacted"'*|*'"type":"compacted"'*|*'"type": "compacted"'*)
          compaction_count=$((compaction_count + 1))
          latest_compaction_timestamp="$(printf '%s\n' "$line" | json_string_field timestamp)"
          latest_compaction_file="$file"
          case "$line" in
            *'"context_compacted"'*) latest_compaction_kind="event_msg.context_compacted" ;;
            *) latest_compaction_kind="compacted" ;;
          esac
          ;;
      esac
    done < "$file"
  done

  if [ -n "$latest_token_line" ]; then
    printf 'token_count_status=found\n'
    printf 'latest_token_count_session=%s\n' "$latest_token_file"
    printf 'latest_token_count_timestamp=%s\n' "$(printf '%s\n' "$latest_token_line" | json_string_field timestamp)"
    printf 'model_context_window=%s\n' "$(printf '%s\n' "$latest_token_line" | json_number_field model_context_window)"
    printf 'token_total_tokens=%s\n' "$(printf '%s\n' "$latest_token_line" | json_object_number_field total_token_usage total_tokens)"
    printf 'token_input_tokens=%s\n' "$(printf '%s\n' "$latest_token_line" | json_object_number_field total_token_usage input_tokens)"
    printf 'token_cached_input_tokens=%s\n' "$(printf '%s\n' "$latest_token_line" | json_object_number_field total_token_usage cached_input_tokens)"
    printf 'token_output_tokens=%s\n' "$(printf '%s\n' "$latest_token_line" | json_object_number_field total_token_usage output_tokens)"
    printf 'token_reasoning_output_tokens=%s\n' "$(printf '%s\n' "$latest_token_line" | json_object_number_field total_token_usage reasoning_output_tokens)"
    printf 'last_token_total_tokens=%s\n' "$(printf '%s\n' "$latest_token_line" | json_object_number_field last_token_usage total_tokens)"
    printf 'last_token_input_tokens=%s\n' "$(printf '%s\n' "$latest_token_line" | json_object_number_field last_token_usage input_tokens)"
    printf 'last_token_cached_input_tokens=%s\n' "$(printf '%s\n' "$latest_token_line" | json_object_number_field last_token_usage cached_input_tokens)"
    printf 'last_token_output_tokens=%s\n' "$(printf '%s\n' "$latest_token_line" | json_object_number_field last_token_usage output_tokens)"
    printf 'last_token_reasoning_output_tokens=%s\n' "$(printf '%s\n' "$latest_token_line" | json_object_number_field last_token_usage reasoning_output_tokens)"
  else
    printf 'token_count_status=missing\n'
  fi

  printf 'compactions_seen=%s\n' "$compaction_count"
  if [ -n "$latest_compaction_timestamp" ]; then
    printf 'latest_compaction_timestamp=%s\n' "$latest_compaction_timestamp"
    printf 'latest_compaction_session=%s\n' "$latest_compaction_file"
    printf 'latest_compaction_kind=%s\n' "$latest_compaction_kind"
  else
    printf 'latest_compaction_timestamp=none\n'
  fi
}

ref_value() {
  printf '%s' "$1" | tr '\r\n' '  '
}

find_prefix() {
  if [ -n "${PREFIX:-}" ] && [ -d "${PREFIX%/}/local" ]; then
    printf '%s\n' "${PREFIX%/}"
    return 0
  fi
  if [ -n "${PKG:-}" ]; then
    for prefix in "/data/user/0/$PKG" "/data/data/$PKG"; do
      [ -d "$prefix/local" ] && { printf '%s\n' "$prefix"; return 0; }
    done
  fi
  for prefix in \
    /data/user/0/com.gzy3894.codexfortui \
    /data/data/com.gzy3894.codexfortui \
    /data/user/0/com.gzy3894.codexfortui.test \
    /data/data/com.gzy3894.codexfortui.test \
    /data/user/0/com.gzy3894.codexfortui.debug \
    /data/data/com.gzy3894.codexfortui.debug
  do
    [ -d "$prefix/local" ] && { printf '%s\n' "$prefix"; return 0; }
  done
  return 1
}

write_session_event() {
  event_id="$1"
  event_name="$2"
  phase="$3"
  trigger="$4"
  reason="$5"
  prefix="$(find_prefix 2>/dev/null || true)"
  [ -n "$prefix" ] || return 0
  dir="$prefix/local/session-fold"
  mkdir -p "$dir" 2>/dev/null || return 0
  {
    printf 'event_id=%s\n' "$event_id"
    printf 'source=context\n'
    printf 'type=context_%s\n' "$phase"
    printf 'state=%s\n' "$phase"
    printf 'reason=%s\n' "$(ref_value "$reason")"
    printf 'hook_event=%s\n' "$(ref_value "$event_name")"
    printf 'trigger=%s\n' "$(ref_value "$trigger")"
    printf '%s\n' '---'
  } >> "$dir/events" 2>/dev/null || true
}

record_event() {
  event_name="$1"
  trigger="$2"
  reason="$3"
  dir="$(state_dir)"
  mkdir -p "$dir"
  stamp="$(date +%s 2>/dev/null || printf 0).$$"
  case "$event_name" in
    PreCompact) phase="pre_compact" ;;
    PostCompact) phase="post_compact" ;;
    SessionStart) phase="session_start" ;;
    *) phase="hook" ;;
  esac
  {
    printf 'event_id=%s\n' "$stamp"
    printf 'source=context\n'
    printf 'hook_event=%s\n' "$(ref_value "$event_name")"
    printf 'phase=%s\n' "$phase"
    printf 'trigger=%s\n' "$(ref_value "$trigger")"
    printf 'reason=%s\n' "$(ref_value "$reason")"
    printf 'cwd=%s\n' "$(pwd 2>/dev/null || true)"
    printf 'stamp=%s\n' "$stamp"
  } > "$dir/status.tmp.$$"
  mv "$dir/status.tmp.$$" "$dir/status"
  {
    cat "$dir/status"
    printf '%s\n' '---'
  } >> "$dir/events"
  write_session_event "$stamp" "$event_name" "$phase" "$trigger" "$reason"
}

run_hook() {
  input="$(cat || true)"
  event_name=""
  trigger=""
  reason=""
  if [ -n "$input" ]; then
    event_name="$(printf '%s' "$input" | json_value hook_event_name)"
    [ -n "$event_name" ] || event_name="$(printf '%s' "$input" | json_value hookEventName)"
    [ -n "$event_name" ] || event_name="$(printf '%s' "$input" | json_value event)"
    trigger="$(printf '%s' "$input" | json_value trigger)"
    [ -n "$trigger" ] || trigger="$(printf '%s' "$input" | json_value compact_trigger)"
    [ -n "$trigger" ] || trigger="$(printf '%s' "$input" | json_value source)"
    [ -n "$trigger" ] || trigger="$(printf '%s' "$input" | json_value matcher)"
    reason="$(printf '%s' "$input" | json_value reason)"
  fi
  [ -n "$event_name" ] || event_name="unknown"
  [ -n "$trigger" ] || trigger="unknown"
  [ -n "$reason" ] || reason="$event_name:$trigger"
  record_event "$event_name" "$trigger" "$reason"
}

status() {
  cfg="$(config_file)"
  printf 'codex_home=%s\n' "$(codex_home)"
  printf 'config=%s\n' "$cfg"
  printf 'state_dir=%s\n' "$(state_dir)"
  if [ -f "$cfg" ] && grep -Eq '^[[:space:]]*model_auto_compact_token_limit[[:space:]]*=' "$cfg"; then
    sed -n 's/^[[:space:]]*model_auto_compact_token_limit[[:space:]]*=[[:space:]]*/model_auto_compact_token_limit=/p' "$cfg" | sed -n '1p'
  else
    printf 'model_auto_compact_token_limit=default\n'
  fi
  config_route_status
  scan_transcript_status
  if [ -f "$cfg" ] && grep -Eq '^[[:space:]]*hooks[[:space:]]*=[[:space:]]*true' "$cfg"; then
    printf 'hooks_feature=true\n'
  elif [ -f "$cfg" ] && grep -Eq '^[[:space:]]*hooks[[:space:]]*=[[:space:]]*false' "$cfg"; then
    printf 'hooks_feature=false\n'
  else
    printf 'hooks_feature=default\n'
  fi
  source="$(hook_source)"
  if [ "$source" != "disabled" ]; then
    printf 'context_hook=enabled\n'
  else
    printf 'context_hook=disabled\n'
  fi
  printf 'context_hook_source=%s\n' "$source"
  if [ -r "$(state_dir)/status" ]; then
    cat "$(state_dir)/status"
  fi
}

events() {
  [ -r "$(state_dir)/events" ] && cat "$(state_dir)/events"
}

verify() {
  tmp="${TMPDIR:-/tmp}/codex-context-verify.$$"
  rm -rf "$tmp"
  mkdir -p "$tmp/home/.codex"
  CODEX_HOME="$tmp/home/.codex" HOME="$tmp/home" sh "$0" enable >/dev/null
  grep -F 'codex-for-tui-context-hook begin' "$tmp/home/.codex/config.toml" >/dev/null 2>&1 || {
    printf '%s\n' "context hook 未写入 config.toml" >&2
    rm -rf "$tmp"
    exit 1
  }
  sample='{"hook_event_name":"PreCompact","trigger":"auto"}'
  printf '%s' "$sample" | CODEX_HOME="$tmp/home/.codex" HOME="$tmp/home" sh "$0" hook
  grep -F 'phase=pre_compact' "$tmp/home/.codex/context-state/events" >/dev/null 2>&1 || {
    printf '%s\n' "context hook 未记录 pre_compact" >&2
    rm -rf "$tmp"
    exit 1
  }
  rm -rf "$tmp"
  printf '%s\n' "Codex context hook 可用。首次启用后请在 Codex 内用 /hooks 信任该 hook。"
}

[ "$#" -ge 1 ] || { usage >&2; exit 2; }

cmd="$1"
shift

case "$cmd" in
  status)
    status
    ;;
  events)
    events
    ;;
  hook)
    run_hook
    ;;
  enable)
    set_hooks_feature true
    install_hook_block
    printf '%s\n' "已启用 Codex for TUI context hook。请在 Codex 内运行 /hooks 信任该 hook。"
    ;;
  disable)
    remove_hook_block
    printf '%s\n' "已移除 Codex for TUI context hook。未修改用户其他 hooks。"
    ;;
  verify)
    verify
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
